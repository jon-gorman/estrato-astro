---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import LandingHeader from "../components/LandingHeader.astro";
import LandingFooter from "../components/LandingFooter.astro";
import Pending from "../components/Pending.astro";
import BatchCalculator from "../components/BatchCalculator.astro";
import { content } from "../data/house-pour";

import hero from "../assets/house/hero-dinner.jpg";
import cantarito from "../assets/house/cantarito-glass.jpg";
import engMargarita from "../assets/icons-illustrated/margarita.png";
import engPaloma from "../assets/icons-illustrated/paloma.png";
import engRanch from "../assets/icons-illustrated/ranch-water.png";
import prodPinas from "../assets/house/prod-pinas.jpg";
import prodSplit from "../assets/house/prod-split.jpg";
import prodOven from "../assets/house/prod-oven.jpg";
import prodMill from "../assets/house/prod-mill.jpg";
import batchPhoto from "../assets/batch/batch-photo.jpg";
import batchCantarito from "../assets/batch/batch-cantarito.jpg";
import church from "../assets/house/church.png";
// bottle cutout with a full, contained contact shadow (the original PNG had its baked shadow clipped at the file edge)
import bottle from "../assets/products/bottle-750-fullshadow.png";
import agaveArt from "../assets/process/agave.png";
import cookArt from "../assets/process/cook.png";
import distillArt from "../assets/process/distill.png";
import pourWide from "../assets/people/pour-wide.jpg";

const margarita = (await getEntry("cocktails", "margarita"))!;
const m = margarita.data;
const cant = (await getEntry("cocktails", "cantarito"))!.data;
const cantExtras = ["Ice", "Tajín (chili-lime seasoning) or coarse salt for the rim", "Lime, orange, and grapefruit wedges to garnish"];
// "2 oz Estrato · 1 oz orange liqueur · 1 oz fresh lime juice"
const recipeLine = m.build.map((b) => `${b.amount} ${b.item}`).join(" · ");

const occasions = [
  { name: "Margarita", img: engMargarita, alt: "Engraving of a salt-rimmed Margarita on the rocks with a lime wedge", href: "/cocktails/margarita/" },
  { name: "Paloma", img: engPaloma, alt: "Engraving of a Paloma highball with grapefruit", href: "/cocktails/paloma/" },
  { name: "Ranch Water", img: engRanch, alt: "Engraving of a Ranch Water highball with lime", href: "/cocktails/ranch-water/" },
];

// GUARDRAIL: the sourcing explanation (Zacatecas) appears only in the FAQ and is flagged in the brief as needing
// confirmation against the approved classification before publication. "Baked for 18 hours" is from
// the site's approved fact set (ProcessSection / FAQ).
const reasons = [
  { h: "100% blue agave", p: "Made with mature blue agave.", art: agaveArt, alt: "Engraving of a blue agave plant" },
  { h: "Traditional production", p: "Fully mature agave is baked for 18 hours, then fermented and double-distilled.", art: cookArt, alt: "Engraving of agave piñas being cooked" },
  { h: "Additive free", p: "Let the agave speak for itself.", art: distillArt, alt: "Engraving of a copper still" },
];

// Real production photographs supplied by the brand. Captions describe only what is visible.
const strip = [
  { img: prodPinas, alt: "A large pile of harvested agave piñas", cap: "Harvested piñas" },
  { img: prodSplit, alt: "Workers splitting large agave piñas by hand at the distillery", cap: "Splitting piñas" },
  { img: prodOven, alt: "An oven door open to reveal a stack of cooked agave piñas", cap: "Cooked piñas" },
  { img: prodMill, alt: "A row of roller mills on a raised platform under a covered roof", cap: "The roller mill" },
];

// Approved fact set (same facts as the home page's "The liquid" section). ABV is added only once confirmed.
const spec = [
  { k: "Agave", v: "100% blue agave" },
  { k: "Cooked", v: "Baked for 18 hours" },
  { k: "Made", v: "Fermented with selected yeast, double-distilled" },
  { k: "Origin", v: "Produced in Tequila, Jalisco, Mexico" },
  { k: "Additives", v: "Additive free" },
  { k: "Size", v: content.abv ? `750 ml · ${content.abv}` : "750 ml" },
];
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1) + ".";
const tasting = content.tasting
  ? [
      { k: "Appearance", v: content.tasting.appearance },
      { k: "Nose", v: content.tasting.nose },
      { k: "Palate", v: content.tasting.palate },
      { k: "Finish", v: content.tasting.finish },
    ]
  : content.review
    ? [
        { k: "Nose", v: cap(content.review.nose) },
        { k: "Palate", v: cap(content.review.palate) },
        { k: "Finish", v: cap(content.review.finish) },
      ]
    : null;


// Attributed paraphrase of a third-party review (see data/house-pour.ts). Not a verbatim quote,
// and never attributed to a bartender or account.
const r = content.review;
const reviewFull = r
  ? `${r.source}'s reviewers describe the nose as ${r.nose}; the palate as ${r.palate}; and the finish as ${r.finish}.`
  : null;
const live = content.publish;

const faqs: { q: string; a?: string; cite?: string; pending?: string | null; fallback?: string; link?: [string, string][] }[] = [
  {
    q: "Is Estrato tequila?",
    a: "No. Estrato is an agave spirit made with 100% blue agave sourced from Zacatecas, outside tequila's designated growing region, and produced in Tequila, Jalisco.",
  },
  {
    q: "What does it taste like?",
    a: content.sensory ?? reviewFull ?? undefined,
    cite: !content.sensory && r ? `Review of ${r.about} by ${r.source}.` : undefined,
    fallback: content.sensory || r ? undefined : "An approved sensory description covering aroma, flavor, and finish. Avoid comparisons with other brands.",
  },
  {
    q: "What can I make with it?",
    a: "Start with the margarita recipe above, then try a Paloma, a Ranch Water, or anything else on the cocktails page.",
    link: [["Paloma recipe", "/cocktails/paloma/"], ["All cocktails", "/cocktails/"]],
  },
  {
    q: "Can I drink it straight?",
    a: "The team reports that customers enjoy Estrato both straight and mixed.",
    fallback: content.straight ? undefined : "A verified serving suggestion and tasting note.",
    pending: content.straight,
  },
  { q: "Why is it $16.99?", a: content.priceReason ?? undefined, fallback: content.priceReason ? undefined : "A substantiated explanation of the price from the brand. Do not attribute savings to certification or sourcing without confirmation." },
  {
    q: "Where can I order it, and what does shipping cost?",
    a: "Order online through the Estrato cart. Shipping is calculated at checkout, before you pay. Online orders are processed and fulfilled by licensed third-party retailers in the Bottle Nexus network, and shipping availability varies by state.",
    link: [["Shipping & Returns", "/shipping-returns/"]],
    pending: content.delivery,
  },
].filter((f) => f.a || f.pending || !live);
const half = Math.ceil(faqs.length / 2);
const faqCols = [faqs.slice(0, half), faqs.slice(half)];

// the "Draft" banner shows until every piece of verified content is in
const open = [
  content.abv, content.flavor ?? content.review, content.sensory ?? content.review,
  content.straight, content.priceReason,
].filter((v) => !v).length;
---

<Base
  title="Meet your next house pour — Estrato"
  description="Estrato is a 100% blue agave spirit for the cocktails you love to make and share. $16.99 per bottle."
  noindex
>
  <div class="hp" id="top">
    {!live && open > 0 && (
      <p class="hp-draft">
        Draft page &mdash; not linked or indexed. {open} {open === 1 ? "item still needs" : "items still need"} verified content.
      </p>
    )}
    <LandingHeader />

    <main>
      <!-- HERO -->
      <section class="hp-hero">
        <div class="hp-hero__stage">
          <div class="hp-hero__art">
            <Image class="hp-hero__bg" src={hero} alt="Friends laughing around a candlelit dinner table as one pours a pitcher of margarita, with an Estrato Indigo bottle on the table" widths={[800, 1200, 1672]} sizes="(max-width: 860px) 100vw, 66vw" loading="eager" />
          </div>

          <div class="hp-hero__copy">
            <h1 class="hp-hero__title">Meet your next<br />house pour.</h1>
            <p class="hp-hero__eyebrow">100% Blue Weber Agave &ndash; Produced in Jalisco</p>
            <p class="hp-hero__sub">
              Estrato is made from 100% blue agave. It's the spirit that is perfect for the cocktails you love to make&mdash;and share. Traditionally
              made, additive free, at a price that makes keeping a bottle on hand an easy decision.
            </p>
            <p class="hp-hero__price"><span class="hp-hero__cur">$</span>16.99 <span class="hp-hero__per">per bottle</span></p>
            <button class="hp-btn" type="button" data-bn-add data-bn-qty="1">Shop Estrato <span aria-hidden="true">&#8594;</span></button>
            <p class="hp-hero__fine">
              750 ml{content.abv ? ` · ${content.abv}` : ""} &middot; Shipping calculated at checkout
            </p>
            {!content.abv && <Pending inline label="ABV, confirmed against the label" />}
          </div>
        </div>
      </section>

      <!-- PRODUCT -->
      <section class="hp-prod" id="product">
        <div class="hp-wrap">
          <header class="hp-prod__head">
            <h2 class="hp-h2 hp-prod__title">Estrato. A choice you can make with confidence.</h2>
            <p class="hp-prod__stmt">100% blue agave, additive free, and produced in Jalisco, Tequila town</p>
          </header>

          <div class="hp-prod__grid">
            <div class="hp-prod__bottle" data-ball>
              <span class="hp-prod__ballwrap" aria-hidden="true"><span class="hp-prod__disc"></span></span>
              <Image src={bottle} alt="An Estrato Indigo 750 ml bottle" widths={[500, 800, 1100]} sizes="(max-width: 860px) 90vw, 36vw" />
              <span class="hp-prod__burst" aria-hidden="true"></span>
            </div>

            <div class="hp-prod__info">
              {tasting && (
                <div class="hp-prod__block">
                  <h3>Tasting notes</h3>
                  <dl class="hp-prod__notes">
                    {tasting.map((t) => (
                      <div><dt>{t.k}</dt><dd>{t.v}</dd></div>
                    ))}
                  </dl>
                  {!content.tasting && content.review && (
                    <p class="hp-prod__cite">As described in {content.review.source}&rsquo;s review of {content.review.about}.</p>
                  )}
                  {!content.tasting && <Pending label="Brand-approved tasting notes (aroma, flavor, finish) to replace the third-party review." />}
                </div>
              )}

              <div class="hp-prod__block">
                <h3>In the bottle</h3>
                <dl class="hp-prod__spec">
                  {spec.map((r) => (
                    <div><dt>{r.k}</dt><dd>{r.v}</dd></div>
                  ))}
                </dl>
                {!content.abv && <Pending inline label="ABV, confirmed against the label" />}
              </div>

              <div class="hp-prod__buy">
                <p class="hp-prod__price"><span>$</span>16.99 <small>per bottle</small></p>
                <button class="hp-btn" type="button" data-bn-add data-bn-qty="1">Shop Estrato <span aria-hidden="true">&#8594;</span></button>
              </div>
            </div>
          </div>

          <div class="hp-prod__story">
            <div class="hp-prod__flow">
              <div class="hp-prod__node">
                <Image src={cookArt} alt="" widths={[200, 360]} sizes="130px" />
                <p><strong>100%</strong>Blue agave</p>
              </div>
              <span class="hp-prod__arrow" aria-hidden="true">&#8594;</span>
              <div class="hp-prod__node">
                <Image src={church} alt="" widths={[260, 420]} sizes="150px" />
                <p><strong>Produced</strong>Tequila, Jalisco</p>
              </div>
              <span class="hp-prod__arrow" aria-hidden="true">&#8594;</span>
              <div class="hp-prod__node">
                <Image src={distillArt} alt="" widths={[200, 360]} sizes="130px" />
                <p><strong>Double</strong>distilled</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SIGNATURE: THE CANTARITO -->
      <section class="hp-sig" id="cantarito">
        <div class="hp-wrap hp-sig__grid">
          <figure class="hp-sig__media">
            <Image src={cantarito} alt="A tall glass of Cantarito over ice with a chili-lime rim and grapefruit and lime garnish, beside halved citrus" widths={[600, 900, 1300]} sizes="(max-width: 860px) 94vw, 48vw" />
            <figcaption class="hp-sig__badge">Our signature pour</figcaption>
          </figure>
          <div class="hp-sig__copy">
            <h2 class="hp-h2 hp-sig__h">The Estrato<br />Cantarito.</h2>
            <p class="hp-sig__lead">
              Orange, lime, and grapefruit over ice, topped with cold grapefruit soda in a tall glass with a chili-lime
              rim. A Jalisco classic, made the Mexican way: bright, a little salty, and easy to make at home.
            </p>

            <div class="hp-sig__cols">
              <div>
                <h3>What you&rsquo;ll need</h3>
                <ul class="hp-sig__ing">
                  {cant.build.map((b) => (
                    <li><span>{b.amount}</span> {b.item}</li>
                  ))}
                  {cantExtras.map((e) => <li class="hp-sig__extra">{e}</li>)}
                </ul>
              </div>
              <div>
                <h3>How to make it</h3>
                <ol class="hp-sig__steps">
                  {cant.steps.map((st) => <li>{st}</li>)}
                </ol>
              </div>
            </div>

            <p class="hp-sig__tip">{cant.note}</p>


            <button class="hp-btn" type="button" data-bn-add data-bn-qty="1">Get Estrato for your Cantarito <span aria-hidden="true">&#8594;</span></button>
          </div>
        </div>
      </section>

      <!-- THE EVERYDAY OCCASION -->
      <section class="hp-occ">
        <div class="hp-wrap">
          <h2 class="hp-h2 hp-occ__h">Your favorite cocktail. A new go-to bottle.</h2>
          <p class="hp-occ__p">
            A margarita while making dinner. A paloma with friends. A ranch water on the porch. Estrato deserves a
            place in your routine because of what it brings to your glass.
          </p>
          <ul class="hp-occ__grid">
            {occasions.map((o) => (
              <li>
                <a class="hp-occ__card" href={o.href}>
                  <Image src={o.img} alt={o.alt} widths={[300, 500, 700]} sizes="(max-width: 860px) 60vw, 22vw" />
                  <span class="hp-occ__name">{o.name}</span>
                </a>
              </li>
            ))}
          </ul>
          {content.flavor && <p class="hp-occ__flavor">{content.flavor}</p>}
        </div>
      </section>

      <!-- THE REASON TO BELIEVE -->
      <section class="hp-why" id="why">
        <Image class="hp-why__corner" src={agaveArt} alt="" widths={[360, 560]} sizes="260px" />
        <div class="hp-wrap">
          <div class="hp-why__head">
            <h2 class="hp-h2 hp-why__title">What goes into your pour matters.</h2>
            <p class="hp-why__made">Produced in<br />Tequila, Jalisco</p>
          </div>
          <ul class="hp-why__grid">
            {reasons.map((x) => (
              <li class="hp-why__item">
                <Image class="hp-why__art" src={x.art} alt={x.alt} widths={[200, 360]} sizes="120px" />
                <div>
                  <h3 class="hp-why__h">{x.h}</h3>
                  <p>{x.p}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <ul class="hp-why__strip">
          {strip.map((s) => (
            <li>
              <Image src={s.img} alt={s.alt} widths={[360, 640, 900]} sizes="(max-width: 860px) 50vw, 25vw" />
              <span>{s.cap}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ACCOUNT TESTIMONY / WHAT REVIEWERS SAY -->
      <section class="hp-tst">
        <Image class="hp-tst__agave" src={agaveArt} alt="" widths={[360, 560]} sizes="260px" />
        <div class="hp-wrap hp-tst__grid">
          <div class="hp-tst__media">
            {content.testimonial.videoSrc ? (
              <video controls playsinline preload="metadata" poster={content.bartenderVideo?.poster ?? pourWide.src} src={content.testimonial.videoSrc}></video>
            ) : content.bartenderVideo ? (
              <div class="hp-tst__player" data-player>
                <video playsinline preload="none" poster={content.bartenderVideo.poster} aria-label="A bartender squeezes lime, shakes, and serves a margarita made with Estrato">
                  <source src={content.bartenderVideo.src} type="video/mp4" />
                </video>
                <button class="hp-tst__play" type="button" aria-label="Play video">
                  <svg viewBox="0 0 24 24" width="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                </button>
              </div>
            ) : (
              <Image src={pourWide} alt="A bartender measuring Estrato from a jigger into a glass of crushed ice at a dim, amber-lit bar" widths={[600, 900, 1400]} sizes="(max-width: 860px) 94vw, 52vw" />
            )}
            {/* NOTE: the bartender here is the stock photograph / generated footage, atmosphere only. Do not pair
                it with a named quote or caption it as a real account. */}
          </div>
          <div class="hp-tst__copy">
            <h2 class="hp-h2 hp-tst__title">Why it stays<br />behind the bar.</h2>
            {content.testimonial.quote && content.testimonial.name ? (
              <blockquote class="hp-tst__quote">
                <span class="hp-tst__mark" aria-hidden="true">&ldquo;</span>
                <p>{content.testimonial.quote}</p>
                <footer>
                  <strong>{content.testimonial.name}</strong>
                  {content.testimonial.account && <span>{content.testimonial.account}</span>}
                </footer>
              </blockquote>
            ) : reviewFull ? (
              <div class="hp-tst__quote">
                <span class="hp-tst__mark" aria-hidden="true">&ldquo;</span>
                <p>{reviewFull}</p>
                <footer><strong>{r.source}</strong><span>Review of {r.about}</span></footer>
              </div>
            ) : (
              <Pending label="The exact, approved quote naming the drink and why they reorder, plus the bartender's name, account, and city." />
            )}
            {content.customerQuote && (
              <blockquote class="hp-tst__quote hp-tst__quote--alt">
                <p>{content.customerQuote.quote}</p>
                <footer><strong>{content.customerQuote.by}</strong></footer>
              </blockquote>
            )}
          </div>
        </div>
      </section>

      <!-- BATCH COCKTAILS -->
      <section class="hp-batch" id="batch">
        <div class="hp-batch__copy">
          <h2 class="hp-h2 hp-batch__h">Batch it for the table.</h2>
          <p class="hp-batch__lead">Tell us how many people, and we&rsquo;ll scale the recipe and count the bottles.</p>

          <BatchCalculator theme="orange" />
        </div>
        <div class="hp-batch__media" data-batch-media>
          <Image data-recipe="margarita" src={batchPhoto} alt="A glass pitcher of margarita with lime wheels beside an Estrato Indigo bottle and four salt-rimmed glasses on a sunlit table" widths={[700, 1000, 1400]} sizes="(max-width: 860px) 100vw, 50vw" />
          <Image data-recipe="cantarito" src={batchCantarito} alt="A glass pitcher of Cantarito with grapefruit, orange, and lime slices beside an Estrato Indigo bottle and four chili-lime-rimmed glasses on a sunlit table" widths={[700, 1000, 1400]} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" />
        </div>
      </section>

      <!-- SHORT FAQ -->
      <section class="hp-faq" id="faq">
        <div class="hp-wrap">
          <h2 class="hp-faq__title">Frequently asked questions</h2>
          <div class="hp-faq__cols">
            {faqCols.map((col) => (
              <div class="hp-faq__col">
                {col.map((f) => (
                  <details class="hp-faq__item">
                    <summary>{f.q}<span class="hp-faq__plus" aria-hidden="true"></span></summary>
                    <div class="hp-faq__a">
                      {f.a && <p>{f.a}</p>}
                      {f.cite && <p class="hp-faq__cite">{f.cite}</p>}
                      {f.link && (
                        <p class="hp-faq__links">
                          {f.link.map(([label, href]) => <a href={href}>{label} <span aria-hidden="true">&#8594;</span></a>)}
                        </p>
                      )}
                      {f.pending && <p>{f.pending}</p>}
                      {f.fallback && <Pending label={f.fallback} />}
                    </div>
                  </details>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <LandingFooter />
  </div>
</Base>

<style>
  /* This page has its own palette: the brighter citrus orange from the mockup. */
  .hp {
    --hp-orange: #e4441c;
    --hp-cream: #fbf3e3;
    --hp-ink: #171310;
    background: var(--hp-cream);
    color: var(--hp-ink);
    scroll-behavior: smooth;
  }
  .hp-draft {
    padding: 0.55rem 1rem;
    background: var(--hp-ink);
    color: var(--hp-cream);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }
  .hp-wrap { max-width: 1240px; margin-inline: auto; }
  .hp-h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.004em;
    line-height: 0.95;
    font-size: clamp(1.9rem, 0.9rem + 2.8vw, 3.2rem);
  }

  .hp-btn {
    display: inline-block;
    padding: 1.05em 2em;
    background: var(--hp-orange);
    color: #fff7ea;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.72rem, 0.64rem + 0.3vw, 0.86rem);
    text-align: center;
    transition: filter 0.15s ease;
  }
  .hp-btn:hover { filter: brightness(0.92); }
  .hp-btn:disabled { opacity: 0.6; cursor: default; }
  .hp-btn--dark { background: #1a1612; color: #fbf3e3; }
  .hp-btn--dark:hover { filter: brightness(1.25); }

  /* ---- hero ---- */
  .hp-hero__stage {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(540px, 46vw, 680px);
    overflow-x: clip; /* clip sideways only: the agave art must be free to overflow into the next section */
    overflow-y: visible;
    background: #14100c;
    color: #fbf3e3;
  }
  .hp-hero__art { position: absolute; top: 0; right: 0; bottom: 0; width: 66%; }
  .hp-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% 50%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
  }
  .hp-hero__copy {
    position: relative;
    z-index: 1;
    width: min(100%, 45vw, 560px);
    padding: clamp(1.75rem, 3.6vw, 3rem) clamp(1.25rem, 4.5vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.65rem, 1.2vw, 1rem);
  }
  .hp-hero__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 0.92;
    font-size: clamp(2.7rem, 0.8rem + 4.8vw, 5rem);
  }
  .hp-hero__eyebrow { font-weight: 700; letter-spacing: 0.18em; line-height: 1.5; text-transform: uppercase; font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.86rem); }
  .hp-hero__sub { font-size: clamp(0.82rem, 0.76rem + 0.25vw, 0.95rem); line-height: 1.65; color: color-mix(in srgb, #fbf3e3 86%, transparent); max-width: 42ch; }
  .hp-hero__price { font-weight: 700; color: #f0562c; font-size: clamp(2.2rem, 1rem + 3.4vw, 3.6rem); line-height: 1; }
  .hp-hero__cur { font-size: 0.6em; vertical-align: 0.16em; margin-right: 0.04em; }
