<script>
  // Click-to-play (with sound) for the branded bartender clip. Nothing loads until the visitor presses play.
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((box) => {
    const video = box.querySelector("video");
    const btn = box.querySelector<HTMLButtonElement>(".hp-tst__play");
    if (!video || !btn) return;
    btn.addEventListener("click", () => {
      video.controls = true;
      box.setAttribute("data-playing", "");
      void video.play();
    });
    video.addEventListener("ended", () => {
      video.controls = false;
      box.removeAttribute("data-playing");
      video.currentTime = 0;
    });
  });
</script>

<script>
  import { gsap } from "gsap";
  import { initBall } from "../lib/ball";

  // Batch section: crossfade the photo to match the calculator's drink.
  document.addEventListener("batchcalc:recipe", (e) => {
    const key = (e as CustomEvent<{ recipe: string }>).detail.recipe;
    const imgs = document.querySelectorAll<HTMLImageElement>("[data-batch-media] img[data-recipe]");
    if (![...imgs].some((i) => i.dataset.recipe === key)) return; // no photo for this drink: keep the current one
    const dur = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 0.6;
    imgs.forEach((i) => {
      i.loading = "eager";
      gsap.to(i, { opacity: i.dataset.recipe === key ? 1 : 0, duration: dur, ease: "power1.inOut", overwrite: true });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-ball]").forEach(initBall);
</script>
