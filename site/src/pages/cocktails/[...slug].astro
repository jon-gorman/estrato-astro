---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export async function getStaticPaths() {
  const drinks = await getCollection("cocktails");
  return drinks.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={`${d.name} — Estrato`} description={d.deck}>
  <SiteHeader />

  <article class="rx">
    <div class="rx__wrap">
      <a class="rx__back" href="/cocktails/">&#8592;&nbsp; All cocktails</a>

      <header class="rx__head">
        <p class="eyebrow">Cocktail &middot; {d.method}</p>
        <h1 class="rx__title">{d.name}</h1>
        <p class="rx__blurb">{d.deck}</p>
      </header>

      <div class="rx__top">
        <figure class="rx__fig">
          <span class="rx__tick" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="13"><path d="M8 0v16M0 8h16" stroke="currentColor" stroke-width="1" /></svg>
          </span>
          <Image src={d.image} alt={`Estrato ${d.name} — ${d.blurb}`} widths={[360, 620, 900]} sizes="(max-width: 820px) 92vw, 42vw" />
        </figure>

        <dl class="rx__spec">
          {d.ratio && (
            <div class="rx__ratio">
              <dt>Pour ratio</dt>
              <dd>{d.ratio}</dd>
            </div>
          )}
          <div><dt>Glass</dt><dd>{d.glass}</dd></div>
          {d.rim && <div><dt>Rim</dt><dd>{d.rim}</dd></div>}
          <div><dt>Garnish</dt><dd>{d.garnish}</dd></div>
          <div><dt>Method</dt><dd>{d.method}</dd></div>
        </dl>
      </div>

      <div class="rx__cols">
        <section class="rx__build">
          <h2 class="rx__h">The build</h2>
          <ul>
            {d.build.map((b) => (
              <li><span class="rx__amt">{b.amount}</span><span class="rx__item">{b.item}</span></li>
            ))}
          </ul>
        </section>

        <section class="rx__method">
          <h2 class="rx__h">Method</h2>
          <ol>
            {d.steps.map((s) => <li>{s}</li>)}
          </ol>
        </section>
      </div>

      {d.note && (
        <p class="rx__note"><b>Make it yours &mdash;</b> {d.note}</p>
      )}

      <div class="rx__prose"><Content /></div>

      <div class="rx__cta">
        <p class="rx__ctaline">One bottle. Three ingredients. Plenty of ways to make it yours.</p>
        <a class="rx__shop" href="/#shop">Shop Estrato</a>
      </div>
    </div>
  </article>

  <SiteFooter />
</Base>

<style>
  .rx {
    background: var(--cream);
    padding: clamp(1.5rem, 4vw, 3rem) calc(var(--frame-inset) + 0.5rem) clamp(3rem, 7vw, 5rem);
  }
  .rx__wrap { max-width: 1040px; margin-inline: auto; }

  .rx__back {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    color: var(--ink-soft);
    padding: 0.4rem 0;
  }
  .rx__back:hover { color: var(--ink); }

  .rx__head { margin-top: clamp(1rem, 3vw, 2rem); max-width: 30ch; }
  .rx__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 0.92;
    font-size: clamp(3rem, 1rem + 8vw, 6.5rem);
    margin-top: clamp(0.4rem, 1vw, 0.7rem);
  }
  .rx__blurb {
    margin-top: clamp(0.6rem, 1.5vw, 1rem);
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 0.75rem + 0.3vw, 1rem);
    color: var(--ink-soft);
  }

  /* image + spec */
  .rx__top {
    margin-top: clamp(1.75rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .rx__fig {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    padding: clamp(6px, 0.7vw, 10px);
  }
  .rx__fig :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; }
  .rx__tick { position: absolute; top: -6px; left: -6px; color: var(--ink); }
  .rx__tick svg { overflow: visible; display: block; }

  .rx__spec { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .rx__spec > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: clamp(0.72rem, 0.66rem + 0.15vw, 0.82rem);
  }
  .rx__spec dt { color: var(--ink-soft); }
  .rx__spec dd { font-weight: 700; text-align: right; }
  .rx__ratio dd {
    font-size: clamp(1.3rem, 1rem + 1.4vw, 2rem);
    letter-spacing: 0.14em;
    line-height: 1;
  }

  /* build + method */
  .rx__cols {
    margin-top: clamp(2rem, 5vw, 3.25rem);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .rx__h {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.85rem, 0.72rem + 0.4vw, 1.05rem);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  .rx__build ul { list-style: none; margin-top: 0.4rem; }
  .rx__build li {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.72rem + 0.2vw, 0.92rem);
  }
  .rx__amt { flex: none; width: 4.5rem; font-weight: 700; }
  .rx__item { color: var(--ink-soft); }

  .rx__method ol { margin: 0.6rem 0 0; padding-left: 1.4rem; }
  .rx__method li {
    padding: 0.45rem 0;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.72rem + 0.2vw, 0.92rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .rx__method li::marker { color: var(--rust); font-weight: 700; }

  .rx__note {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.7rem + 0.2vw, 0.9rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .rx__note b { color: var(--ink); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }

  .rx__prose {
    margin-top: clamp(1.5rem, 3.5vw, 2.25rem);
    max-width: 60ch;
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 0.74rem + 0.2vw, 0.95rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .rx__prose :global(p + p) { margin-top: 1rem; }

  .rx__cta {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
    flex-wrap: wrap;
  }
  .rx__ctaline {
    flex: 1;
    min-width: 20ch;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1.05;
    font-size: clamp(1.1rem, 0.9rem + 1.2vw, 1.6rem);
  }
  .rx__shop {
    flex: none;
    display: inline-block;
    padding: 1em 2.2em;
    background: var(--rust);
    color: var(--cream-warm);
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: clamp(0.7rem, 0.6rem + 0.3vw, 0.82rem);
    transition: background 0.15s ease;
  }
  .rx__shop:hover { background: var(--rust-dark); }

  @media (max-width: 820px) {
    .rx__top, .rx__cols { grid-template-columns: 1fr; }
    .rx__head { max-width: none; }
  }
</style>
