---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import RuleHeading from "../../components/RuleHeading.astro";

const drinks = (
  await getCollection("cocktails", (d) => d.data.tasted)
).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Cocktails — Estrato" description="Familiar builds, fresh citrus, cold bubbles, and Estrato. Pick a classic or take it somewhere new.">
  <SiteHeader />

  <section class="hub">
    <div class="hub__wrap">
      <RuleHeading text="Pick your pour." />

      <p class="hub__lede">
        Familiar builds, fresh citrus, cold bubbles, and Estrato. Pick a
        classic or take it somewhere new.
      </p>

      <ul class="hub__grid">
        {drinks.map((d) => (
          <li>
            <a class="hub__card" href={`/cocktails/${d.id}/`}>
              <div class="hub__media">
                <Image src={d.data.image} alt={`Estrato ${d.data.name} — ${d.data.blurb}`} widths={[360, 560, 760]} sizes="(max-width: 860px) 90vw, 30vw" />
              </div>
              <div class="hub__foot">
                <h2 class="hub__name">{d.data.name}</h2>
                <span class="hub__rule" aria-hidden="true"></span>
                <p class="hub__blurb">{d.data.blurb}</p>
                {d.data.ratio && <p class="hub__ratio">{d.data.ratio}</p>}
                <span class="hub__link">View full recipe <span aria-hidden="true">&#8594;</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SiteFooter />
</Base>

<style>
  .hub {
    background: var(--cream);
    padding: clamp(2rem, 5vw, 3.5rem) calc(var(--frame-inset) + 0.5rem) clamp(3rem, 7vw, 5rem);
  }
  .hub__wrap { max-width: 1240px; margin-inline: auto; }
  .hub__lede {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 52ch;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 0.75rem + 0.3vw, 1rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .hub__grid {
    list-style: none;
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .hub__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    padding: clamp(0.9rem, 2vw, 1.5rem);
    transition: background 0.15s ease;
  }
  .hub__card:hover { background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .hub__media { height: clamp(150px, 19vw, 230px); display: flex; align-items: center; justify-content: center; }
  .hub__media :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .hub__foot {
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
  }
  .hub__name {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: clamp(0.85rem, 0.72rem + 0.35vw, 1rem);
  }
  .hub__rule { display: block; width: 34px; height: 2px; background: var(--rust); margin: 0.6rem 0; }
  .hub__blurb {
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 0.63rem + 0.15vw, 0.8rem);
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .hub__ratio {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    font-size: 0.8rem;
  }
  .hub__link {
    display: inline-block;
    margin-top: clamp(0.7rem, 1.6vw, 1rem);
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    border-bottom: 2px solid var(--rust);
    padding-bottom: 0.2rem;
  }

  @media (max-width: 860px) {
    .hub__grid { grid-template-columns: 1fr; max-width: 440px; margin-inline: auto; }
  }
</style>
