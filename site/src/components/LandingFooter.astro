---
import { Image } from "astro:assets";
import wordmark from "../assets/brand/wordmark-cream.png";

const year = new Date().getFullYear();
---

<footer class="lf">
  <div class="lf__top">
    <a class="lf__mark" href="#top" aria-label="Estrato Indigo, back to top">
      <Image src={wordmark} alt="Estrato Indigo" widths={[260, 420]} sizes="200px" />
    </a>
    <button class="lf__cta" type="button" data-bn-add data-bn-qty="1">Shop Estrato <span aria-hidden="true">&#8594;</span></button>
    <nav class="lf__links" aria-label="On this page">
      <a href="#why">Why Estrato</a>
      <a href="#batch">Batch cocktails</a>
      <a href="#faq">FAQ</a>
    </nav>
  </div>

  <div class="lf__fine">
    <p>Please enjoy responsibly. Must be 21+ to purchase.</p>
    <p>
      Online orders are processed and fulfilled by licensed third-party retailers in the Bottle&nbsp;Nexus network.
      Shipping availability varies by state.
    </p>
    <p class="lf__legal">
      <span>&copy; {year} Estrato. All rights reserved.</span>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/shipping-returns/">Shipping &amp; Returns</a>
      <a href="/contact/">Contact</a>
    </p>
  </div>
</footer>

<style>
  .lf { background: #1a1612; border-top: 5px solid var(--aqua, #179a96); color: #f6ecdc; padding: clamp(1.5rem, 3.5vw, 2.5rem) clamp(1rem, 3.2vw, 2.4rem) clamp(1.25rem, 3vw, 2rem); }
  .lf__top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.25rem; }
  .lf__mark { display: block; width: fit-content; }
  .lf__mark :global(img) { display: block; width: auto; height: clamp(34px, 2.4rem + 1vw, 52px); }
  .lf__cta {
    padding: 1.05em 2.2em;
    background: var(--hp-orange, var(--rust));
    color: #fff7ea;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    transition: filter 0.15s ease;
  }
  .lf__cta:hover { filter: brightness(0.92); }
  .lf__cta:disabled { opacity: 0.6; cursor: default; }
  .lf__links { justify-self: end; display: flex; gap: clamp(0.9rem, 2.2vw, 1.75rem); }
  .lf__links a { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in srgb, #f6ecdc 78%, transparent); }
  .lf__links a:hover { color: #f6ecdc; }
  .lf__fine { margin-top: clamp(1.25rem, 3vw, 2rem); padding-top: 1.1rem; border-top: 1px solid color-mix(in srgb, #f6ecdc 18%, transparent); display: grid; gap: 0.5rem; font-size: 0.7rem; line-height: 1.6; color: color-mix(in srgb, #f6ecdc 65%, transparent); }
  .lf__legal { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
  .lf__legal a { text-decoration: underline; text-underline-offset: 0.2em; }
  .lf__legal a:hover { color: #f6ecdc; }
  @media (max-width: 760px) {
    .lf__top { grid-template-columns: 1fr; justify-items: start; }
    .lf__links { justify-self: start; }
  }
</style>
