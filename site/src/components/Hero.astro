---
import { Image, getImage } from "astro:assets";
import clusterDesktop from "../assets/hero/cluster-desktop.png";
import clusterMobile from "../assets/hero/cluster-mobile.png";
import flourish from "../assets/hero/flourish-acanthus.png";

const ticks = ["tl", "tr", "bl", "br", "ml", "mr"] as const;

// art-directed mobile crop (portrait) — separate source image
const mobileWebp = await getImage({
  src: clusterMobile,
  widths: [480, 760],
  format: "webp",
});
const mobileSrcset = mobileWebp.srcSet.attribute || mobileWebp.src;
---

<section class="hero">
  <div class="hero__frame">
    {ticks.map((c) => (
      <span class={`hero__tick hero__tick--${c}`} aria-hidden="true">
        <svg viewBox="0 0 18 18" width="15"><path d="M9 0v18M0 9h18" stroke="currentColor" stroke-width="0.9" /></svg>
      </span>
    ))}

    <div class="hero__inner">
      <div class="hero__art">
        <Image
          class="hero__flourish"
          src={flourish}
          alt=""
          widths={[360, 640]}
          sizes="34vw"
          loading="eager"
        />
        <picture class="hero__cluster">
          <source
            media="(max-width: 720px)"
            srcset={mobileSrcset}
            sizes="(max-width: 720px) 86vw, 400px"
          />
          <Image
            src={clusterDesktop}
            alt="Estrato bottle beside an iced grapefruit cocktail with fresh citrus"
            widths={[720, 1080, 1448]}
            sizes="(max-width: 900px) 92vw, 60vw"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>

      <div class="hero__copy">
        <div class="hero__lede">
          <p class="eyebrow hero__eyebrow">Mexican Agave Spirit</p>
          <h1 class="hero__title">Big Agave<br />Energy</h1>
          <p class="hero__claim">
            {/* GUARDRAIL: category framing — DRAFT, pending beverage-alcohol counsel. */}
            Agave grown outside the tequila zone, distilled inside it at a Jalisco
            tequila distillery.<br /><b>Not tequila&nbsp;&mdash;&nbsp;on purpose.</b>
          </p>
        </div>

        <div class="hero__buy">
          <ul class="hero__spec" aria-label="At a glance">
            <li>100% Blue Agave<span>*</span></li>
            <li>Jalisco, Mexico<span>*</span></li>
            <li>Double-distilled<span>*</span></li>
            <li>750 ml</li>
          </ul>
          <div class="hero__buyrow">
            <p class="hero__price"><span class="hero__cur">$</span>16.99</p>
            <a class="hero__cta" href="#where-to-buy">Buy a bottle</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 0 var(--frame-inset) var(--frame-inset);
  }

  .hero__frame {
    position: relative;
    border: 1px solid var(--line);
    overflow: clip;
    background: var(--cream);
  }

  /* registration marks */
  .hero__tick { position: absolute; z-index: 4; color: var(--ink); }
  .hero__tick svg { overflow: visible; }
  .hero__tick--tl { top: 12px; left: 12px; }
  .hero__tick--tr { top: 12px; right: 12px; }
  .hero__tick--bl { bottom: 12px; left: 12px; }
  .hero__tick--br { bottom: 12px; right: 12px; }
  .hero__tick--ml { top: 50%; left: 12px; transform: translateY(-50%); }
  .hero__tick--mr { top: 50%; right: 12px; transform: translateY(-50%); }
  @media (max-width: 900px) {
    .hero__tick--ml, .hero__tick--mr { display: none; }
  }

  .hero__inner {
    position: relative;
    min-height: min(56vw, calc(100svh - 66px));
    display: flex;
    align-items: stretch;
    padding: clamp(1.75rem, 4.5vw, 3.5rem) clamp(1.6rem, 5vw, 4.5rem) clamp(1.5rem, 3.5vw, 2.75rem);
  }

  /* ---- art layer (right, behind copy) ---- */
  .hero__art {
    position: absolute;
    top: 0;
    bottom: clamp(-2.75rem, -3.5vw, -1.5rem); /* cancel the inner padding so art meets the frame edge */
    right: clamp(-3rem, -3vw, -0.5rem);
    width: clamp(440px, 72%, 1080px);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .hero__flourish {
    position: absolute;
    top: clamp(1.25rem, 3.5vw, 3rem);
    right: clamp(0.5rem, 3vw, 3.5rem);
    width: clamp(220px, 27vw, 420px);
    height: auto;
    opacity: 1;
    pointer-events: none;
  }

  .hero__cluster {
    width: 100%;
    align-self: flex-end;
  }
  .hero__cluster :global(img) {
    width: 100%;
    height: auto;
    max-height: calc(100svh - 84px);
    object-fit: contain;
    object-position: bottom right;
    -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent 99%);
    mask-image: linear-gradient(to bottom, #000 82%, transparent 99%);
  }

  /* ---- copy (front) ---- */
  .hero__copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: min(48%, 36rem);
  }
  .hero__buy { padding-top: clamp(1.5rem, 4vh, 3rem); }

  .hero__eyebrow { margin-bottom: clamp(0.5rem, 1.4vw, 0.9rem); }

  .hero__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.004em;
    line-height: 0.9;
    font-size: clamp(3rem, 1rem + 9vw, 8.5rem);
    color: var(--ink);
  }

  .hero__claim {
    margin-top: clamp(1rem, 2.2vw, 1.6rem);
    max-width: 30ch;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.68rem + 0.3vw, 0.98rem);
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .hero__claim b { color: var(--ink); font-weight: 700; }

  .hero__spec {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem 1.2rem;
    width: fit-content;
    padding-bottom: clamp(0.9rem, 2vw, 1.4rem);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: clamp(0.62rem, 0.56rem + 0.15vw, 0.74rem);
    color: var(--ink-soft);
  }
  .hero__spec span { color: var(--rust); }

  .hero__buyrow {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin-top: clamp(1rem, 2.2vw, 1.5rem);
    flex-wrap: wrap;
  }
  .hero__price {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--rust);
    font-size: clamp(1.7rem, 1rem + 2.5vw, 3rem);
    letter-spacing: 0.01em;
  }
  .hero__cur { font-size: 0.66em; vertical-align: 0.14em; margin-right: 0.05em; }

  .hero__cta {
    display: inline-block;
    padding: 1.05em 2.6em;
    background: var(--rust);
    color: var(--cream-warm);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(0.72rem, 0.6rem + 0.4vw, 0.9rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.15s ease;
  }
  .hero__cta:hover { background: var(--rust-dark); }

  /* ---- stack on narrow screens ---- */
  @media (max-width: 900px) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      gap: clamp(1.5rem, 6vw, 2.5rem);
      padding-block: clamp(2rem, 8vw, 3rem);
    }
    .hero__art {
      position: static;
      width: 100%;
      justify-content: center;
      order: 2;
      padding: 0;
    }
    .hero__flourish { display: none; }
    .hero__cluster { max-width: none; display: flex; justify-content: center; }
    .hero__cluster :global(img) {
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: 58vh;
      object-fit: contain;
      object-position: center bottom;
    }
    .hero__copy { order: 1; max-width: none; }
    .hero__buy { padding-top: clamp(1.25rem, 5vw, 2rem); }
    .hero__title { font-size: clamp(2.6rem, 12vw, 4.5rem); }
  }
</style>
