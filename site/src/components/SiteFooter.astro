---
import { Image } from "astro:assets";
import wordmark from "../assets/brand/wordmark-cream.png";
import scroll from "../assets/flourish/flat.png";

const nav = [
  { label: "Shop", href: "/#shop" },
  { label: "Cocktails", href: "/cocktails/" },
  { label: "Our story", href: "/#story" },
  { label: "Find Estrato", href: "/#shop" },
  { label: "For restaurants", href: "/#restaurants" },
  { label: "FAQ", href: "/#faq" },
];
const legal = ["Privacy", "Terms", "Accessibility", "Shipping & Returns", "Contact"];
const year = new Date().getFullYear();
---

<footer class="ft">
  <!-- rust CTA band -->
  <div class="ft__band">
    <span class="ft__mark">Estrato</span>
    <p class="ft__bandline">One bottle. Three ingredients. Plenty of ways to make it yours.</p>
    <a class="ft__buy" href="/#shop">Shop Estrato</a>
  </div>

  <!-- black body -->
  <div class="ft__body">
    <Image class="ft__scroll" src={scroll} alt="" widths={[520, 900]} sizes="clamp(240px, 40vw, 520px)" />
    <div class="ft__cols">
      <div class="ft__brand">
        <span class="ft__mark ft__mark--sm">Estrato</span>
        <p class="ft__desc">
          <!-- GUARDRAIL: category is VERIFY — "Mexican Agave Spirit" pending label/legal -->
          Mexican Agave Spirit &middot; 750&nbsp;ml
        </p>
      </div>

      <nav class="ft__nav" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>

      <form class="ft__signup" aria-label="Newsletter signup" onsubmit="return false">
        <p class="ft__signuphead">Get on the good list.</p>
        <p class="ft__signupbody">Cocktail ideas, Estrato sightings, and reasons to mix another round.</p>
        <label for="ft-email">Email address</label>
        <div class="ft__field">
          <input id="ft-email" type="email" placeholder="you@email.com" autocomplete="email" />
          <button type="submit">I&rsquo;m in</button>
        </div>
        <p class="ft__consent">
          By signing up, you agree to receive marketing emails from Estrato.
          You can unsubscribe at any time.
        </p>
        <div class="ft__social">
          <a href="#" aria-label="Instagram">Instagram</a>
          <a href="#" aria-label="TikTok">TikTok</a>
        </div>
      </form>
    </div>

    <p class="ft__responsible">
      <!-- GUARDRAIL: supply/confirm mandated responsible-service wording for each market served before launch -->
      Please enjoy responsibly. Must be 21+ to purchase.
    </p>
    <p class="ft__fulfill">
      Online orders are processed and fulfilled by licensed third-party retailers
      in the Bottle&nbsp;Nexus network. Shipping availability varies by state.
    </p>

    <div class="ft__legal">
      <span>&copy; {year} Estrato. All rights reserved.</span>
      <span class="ft__legal-links">{legal.map((l) => <a href="#">{l}</a>)}</span>
    </div>
  </div>
</footer>

<style>
  .ft__mark {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: clamp(1.6rem, 1rem + 2.4vw, 2.6rem);
    line-height: 1;
  }
  .ft__mark--sm { font-size: clamp(1.3rem, 1rem + 1.4vw, 1.8rem); }

  /* rust band */
  .ft__band {
    background: var(--rust);
    color: var(--cream);
    padding: clamp(1.4rem, 3.5vw, 2.4rem) calc(var(--frame-inset) + clamp(0.75rem, 3vw, 2.5rem));
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
  }
  .ft__bandline {
    flex: 1;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.7rem, 0.6rem + 0.3vw, 0.9rem);
  }
  .ft__buy {
    flex: none;
    border: 1px solid currentColor;
    padding: 0.85em 2em;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: clamp(0.64rem, 0.55rem + 0.3vw, 0.78rem);
    transition: background 0.15s, color 0.15s;
  }
  .ft__buy:hover { background: var(--cream); color: var(--rust); }

  /* black body */
  .ft__body {
    position: relative;
    background: var(--night);
    color: var(--cream);
    padding: clamp(2.75rem, 6vw, 4.25rem) calc(var(--frame-inset) + clamp(0.75rem, 3vw, 2.5rem)) clamp(1.75rem, 4vw, 2.75rem);
  }
  .ft__scroll {
    display: block;
    width: clamp(220px, 38vw, 460px);
    height: auto;
    margin: 0 auto clamp(1.75rem, 4vw, 2.75rem);
    opacity: 0.85;
    filter: invert(1);
    pointer-events: none;
  }
  .ft__cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 20%, transparent);
  }
  .ft__desc {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--cream) 65%, transparent);
  }
  .ft__nav { display: grid; gap: 0.6rem; align-content: start; }
  .ft__nav a,
  .ft__legal a,
  .ft__social a {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.74rem;
    color: color-mix(in srgb, var(--cream) 78%, transparent);
  }
  .ft__nav a:hover,
  .ft__legal a:hover,
  .ft__social a:hover { color: var(--cream); }

  .ft__signuphead {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
  }
  .ft__signupbody {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--cream) 68%, transparent);
  }
  .ft__signup label {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.74rem;
    color: color-mix(in srgb, var(--cream) 78%, transparent);
    margin: 1.1rem 0 0.7rem;
  }
  .ft__field {
    display: flex;
    border: 1px solid color-mix(in srgb, var(--cream) 35%, transparent);
  }
  .ft__field input {
    flex: 1;
    background: none;
    border: 0;
    color: var(--cream);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.7em 0.9em;
  }
  .ft__field input::placeholder { color: color-mix(in srgb, var(--cream) 45%, transparent); }
  .ft__field input:focus { outline: 1px solid var(--cream); outline-offset: -1px; }
  .ft__field button {
    flex: none;
    padding: 0 1.2em;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.74rem;
    color: var(--cream);
    border-left: 1px solid color-mix(in srgb, var(--cream) 35%, transparent);
  }
  .ft__consent {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .ft__social { margin-top: 1rem; display: flex; gap: 1.25rem; }

  .ft__responsible,
  .ft__fulfill {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--cream) 55%, transparent);
    max-width: 70ch;
  }
  .ft__fulfill { margin-top: 0.6rem; }

  .ft__legal {
    margin-top: clamp(1.5rem, 3.5vw, 2.25rem);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .ft__legal-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; }

  @media (max-width: 820px) {
    .ft__band { flex-wrap: wrap; }
    .ft__bandline { flex-basis: 100%; order: 3; }
    .ft__cols { grid-template-columns: 1fr; }
  }
</style>
