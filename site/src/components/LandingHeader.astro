---
import { Image } from "astro:assets";
import wordmark from "../assets/brand/wordmark-ink.png";

/* Minimal header for the paid-ads landing page: no links to the rest of the site, so ad
   traffic stays on the offer. Anchors scroll within the page. */
---

<header class="lh">
  <nav class="lh__links" aria-label="On this page">
    <a href="#why">Why Estrato</a>
    <a href="#batch">Batch cocktails</a>
  </nav>

  <a class="lh__mark" href="#top" aria-label="Estrato Indigo, back to top">
    <Image src={wordmark} alt="Estrato Indigo" widths={[220, 360]} sizes="150px" loading="eager" />
  </a>

  <div class="lh__right">
    <a class="lh__faq" href="#faq">FAQ</a>
    <button class="lh__cta" type="button" data-bn-add data-bn-qty="1">Shop Estrato</button>
    <button class="lh__bag cart-trigger" type="button" aria-label="Open cart" data-cart-bag>
      <svg viewBox="0 0 22 24" width="20" aria-hidden="true">
        <path d="M3 7h16l-1.3 15.5a1 1 0 0 1-1 .9H5.3a1 1 0 0 1-1-.9L3 7Z" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M7.5 9V6a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>
</header>

<style>
  .lh {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: clamp(0.7rem, 1.4vw, 1rem) clamp(1rem, 3.2vw, 2.4rem);
    background: var(--hp-cream, var(--cream));
  }
  .lh__links { display: flex; gap: clamp(1rem, 2.4vw, 2rem); }
  .lh__links a, .lh__faq {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.68rem;
  }
  .lh__links a:hover, .lh__faq:hover { color: var(--hp-orange, var(--rust)); }
  .lh__mark { display: block; }
  .lh__mark :global(img) { display: block; width: auto; height: clamp(30px, 2rem + 1vw, 46px); }
  .lh__right { justify-self: end; display: flex; align-items: center; gap: clamp(0.8rem, 1.8vw, 1.4rem); }
  .lh__cta {
    padding: 0.85em 1.5em;
    background: var(--hp-orange, var(--rust));
    color: #fff7ea;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.7rem;
    transition: filter 0.15s ease;
  }
  .lh__cta:hover { filter: brightness(0.92); }
  .lh__cta:disabled { opacity: 0.6; cursor: default; }
  .lh__bag { position: relative; padding: 4px; color: var(--ink); }
  /* the vendor cart opens only when the click target itself has .cart-trigger */
  .lh__bag > * { pointer-events: none; }
  .lh__bag::after {
    content: "";
    position: absolute;
    top: 1px;
    right: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #f26a1b;
    box-shadow: 0 0 0 2px var(--hp-cream, var(--cream));
    transform: scale(0);
    transition: transform 0.18s ease;
    pointer-events: none;
  }
  .lh__bag[data-has-items]::after { transform: scale(1); }

  @media (max-width: 760px) {
    .lh { grid-template-columns: auto 1fr; }
    .lh__links, .lh__faq { display: none; }
    .lh__mark { order: -1; }
  }
</style>

<script>
  import { initCartDot } from "../lib/cart-dot";
  initCartDot();
</script>
