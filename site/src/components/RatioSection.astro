---
import { Image } from "astro:assets";
import RuleHeading from "./RuleHeading.astro";
import margarita from "../assets/icons-illustrated/margarita.png";
import paloma from "../assets/icons-illustrated/paloma.png";
import ranchWater from "../assets/icons-illustrated/ranch-water.png";
import circleAqua from "../assets/house/circle-aqua.png";
import brushAqua from "../assets/house/brush-aqua.png";

const drinks = [
  {
    name: "Margarita",
    ratio: "2 : 1 : 1",
    pour: ["Estrato", "Orange liqueur", "Lime"],
    icon: margarita,
  },
  {
    name: "Paloma",
    ratio: "2 : 4 : 0.5",
    pour: ["Estrato", "Grapefruit soda", "Lime"],
    icon: paloma,
  },
  {
    name: "Ranch Water",
    ratio: "2 : 4 : 0.5",
    pour: ["Estrato", "Mineral water", "Lime"],
    icon: ranchWater,
  },
];
---

<section class="mix" id="cocktails">
  <Image class="mix__brush" src={brushAqua} alt="" widths={[500, 800]} sizes="30vw" loading="lazy" />
  <div class="mix__wrap">
    <RuleHeading text="Three drinks. Zero drama." />
    <p class="mix__lede">Start with Estrato. Add citrus, bubbles, or both.</p>

    <ul class="mix__grid">
      {drinks.map((d) => (
        <li class="mix__card">
          <span class="mix__ball" aria-hidden="true">
            <Image class="mix__disc" src={circleAqua} alt="" widths={[200, 320]} sizes="150px" loading="lazy" />
            <Image class="mix__icon" src={d.icon} alt="" widths={[160, 260]} sizes="120px" loading="lazy" />
          </span>
          <div class="mix__body">
            <h3 class="mix__name">{d.name}</h3>
            <p class="mix__ratio">{d.ratio}</p>
            <ul class="mix__pour">
              {d.pour.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .mix {
    background: var(--cream);
    padding: clamp(2.5rem, 6vw, 4.5rem) calc(var(--frame-inset) + 0.5rem) clamp(3rem, 7vw, 5rem);
  }
  .mix { position: relative; overflow-x: clip; }
  .mix__wrap { position: relative; z-index: 1; max-width: 1300px; margin-inline: auto; }
  /* aqua brush stroke bleeding in from the left edge, behind the drinks */
  .mix__brush { position: absolute; left: -7%; top: clamp(11rem, 21vw, 17rem); width: min(26vw, 340px); height: auto; transform: rotate(-8deg); pointer-events: none; z-index: 0; }

  .mix__lede {
    margin-top: clamp(0.9rem, 2vw, 1.25rem);
    max-width: 52ch;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 0.75rem + 0.3vw, 1rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* ---- cards ---- */
  .mix__grid {
    list-style: none;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .mix__card {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 2.5vw, 1.9rem);
    padding: 0.25rem clamp(1rem, 3vw, 2.5rem);
  }
  .mix__card + .mix__card { border-left: 1px solid var(--line); }

  /* the circle is its own layer, offset behind the glass; the two drift apart on hover */
  .mix__ball {
    position: relative;
    flex: none;
    align-self: center;
    display: grid;
    place-items: center;
    width: clamp(112px, 11.5vw, 150px);
    aspect-ratio: 1;
  }
  .mix__ball :global(.mix__disc) {
    position: absolute; left: 50%; top: 50%; width: 100%; height: 100%; object-fit: contain; pointer-events: none;
    transform: translate(calc(-50% + var(--dx, 0%)), calc(-50% + var(--dy, 0%)));
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .mix__card:nth-child(1) .mix__ball { --dx: -9%; --dy: -3%; }
  .mix__card:nth-child(2) .mix__ball { --dx: 8%; --dy: -4%; }
  .mix__card:nth-child(3) .mix__ball { --dx: -6%; --dy: -2%; }
  .mix__icon {
    position: relative;
    width: 78%;
    height: auto;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .mix__card:hover .mix__ball :global(.mix__disc) { transform: translate(calc(-50% + var(--dx, 0%) * 1.7), calc(-50% + var(--dy, 0%) * 1.7)) rotate(8deg); }
  .mix__card:hover .mix__icon { transform: translateY(-5px) rotate(-2deg); }
  @media (prefers-reduced-motion: reduce) {
    .mix__ball :global(.mix__disc), .mix__icon { transition: none; }
  }

  .mix__name {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: clamp(0.85rem, 0.7rem + 0.4vw, 1rem);
  }
  .mix__ratio {
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    white-space: nowrap;
    font-size: clamp(1.05rem, 0.85rem + 0.7vw, 1.45rem);
    margin-top: clamp(0.5rem, 1.2vw, 0.8rem);
  }
  .mix__pour {
    list-style: none;
    margin-top: clamp(0.7rem, 1.6vw, 1.1rem);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: clamp(0.68rem, 0.6rem + 0.2vw, 0.8rem);
    line-height: 1.85;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .mix__brush { width: 140px; top: 12.5rem; left: -16%; }
    .mix__grid { grid-template-columns: 1fr; gap: clamp(1.75rem, 6vw, 2.5rem); }
    .mix__card { padding-inline: 0; }
    .mix__card + .mix__card {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-top: clamp(1.75rem, 6vw, 2.5rem);
    }
  }
</style>
