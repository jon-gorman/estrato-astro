---
import { Image } from "astro:assets";
import RuleHeading from "./RuleHeading.astro";
import agave from "../assets/process/agave.png";
import cook from "../assets/process/cook.png";
import ferment from "../assets/process/ferment.png";
import distill from "../assets/process/distill.png";

const steps = [
  { label: "Agave", img: agave, caption: "Fully mature Blue Weber agave, selected at peak maturity." },
  { label: "Cook", img: cook, caption: "Baked for 18 hours using a traditional process." },
  { label: "Ferment", img: ferment, caption: "Fermented with selected high-quality yeast." },
  { label: "Distill", img: distill, caption: "Double-distilled in Tequila, Jalisco, for clarity and character." },
];

/* GUARDRAIL: sourced from the approved estratomx.com fact set. */
---

<section class="proc" id="process">
  <div class="proc__wrap">
    <RuleHeading text="From agave to glass." />
    <div class="proc__intro">
      <h2 class="proc__h">The good stuff, without the speech.</h2>
      <p class="proc__lede">
        Estrato begins with fully mature Blue Weber agave, baked for 18
        hours, fermented with selected yeast, and double-distilled in
        Tequila, Jalisco. The result is a clear, additive-free agave spirit
        made to mix&mdash;or pour neat.
      </p>
    </div>

    <ol class="proc__grid">
      {steps.map((s) => (
        <li class={`proc__step${s.label === "Agave" ? " proc__step--agave" : ""}${s.label === "Ferment" || s.label === "Distill" ? " proc__step--big" : ""}`}>
          <div class="proc__fig">
            <Image src={s.img} alt={`${s.label} — engraving`} widths={[220, 380, 520]} sizes="(max-width: 820px) 40vw, 15vw" />
          </div>
          <p class="proc__label">{s.label}</p>
          <p class="proc__caption">{s.caption}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc {
    background: var(--cream);
    padding: clamp(2.75rem, 6vw, 4.75rem) calc(var(--frame-inset) + 0.5rem) clamp(3.25rem, 7vw, 5.25rem);
  }
  .proc__wrap { max-width: 1240px; margin-inline: auto; }

  .proc__intro {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    max-width: 56ch;
  }
  .proc__h {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 0.96;
    font-size: clamp(1.7rem, 1rem + 2.2vw, 2.75rem);
  }
  .proc__lede {
    margin-top: clamp(0.75rem, 1.8vw, 1.1rem);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.72rem + 0.25vw, 0.95rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .proc__grid {
    list-style: none;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .proc__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: clamp(0.75rem, 2.5vw, 2rem);
  }

  /* dotted connector between figures */
  .proc__step + .proc__step::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8%;
    height: 58%;
    border-left: 2px dotted color-mix(in srgb, var(--ink) 50%, transparent);
  }
  /* + node between labels */
  .proc__step:not(:last-child)::after {
    content: "+";
    position: absolute;
    right: -0.34em;
    bottom: 0.05em;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.7rem + 0.3vw, 1rem);
    line-height: 1;
    color: var(--ink);
    transform: translateX(50%);
  }

  .proc__fig {
    height: clamp(132px, 15.5vw, 205px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .proc__fig :global(img) {
    width: auto;
    height: auto;
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
  }
  /* the agave is a low, wide rosette — let it fill the height and spill a little
     so its visual mass matches the taller piña / tank / still */
  .proc__step--agave .proc__fig :global(img) {
    height: 118%;
    max-height: none;
    max-width: 132%;
  }
  /* ferment (tank) and distill (still) read a touch small next to agave/cook — bump them up */
  .proc__step--big .proc__fig :global(img) {
    height: 114%;
    max-height: none;
    max-width: 114%;
  }

  .proc__label {
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.78rem, 0.66rem + 0.4vw, 0.95rem);
  }
  .proc__caption {
    margin-top: clamp(0.4rem, 1vw, 0.6rem);
    max-width: 20ch;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.62rem + 0.15vw, 0.78rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .proc__grid { grid-template-columns: 1fr 1fr; gap: clamp(2rem, 7vw, 3rem) 0; }
    .proc__step:nth-child(odd)::after,
    .proc__step + .proc__step::before { display: none; }
    .proc__fig { height: clamp(130px, 34vw, 170px); }
  }
  @media (max-width: 420px) {
    .proc__grid { grid-template-columns: 1fr; }
  }
</style>
